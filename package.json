{
  "name": "buja-static-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --base=/buja-clone/ && node scripts/prepare-pages.mjs && node scripts/check-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:score": "node --test test/scoring.test.js",
    "check:data": "node scripts/check-data.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "vite": "6.4.5"
  }
}
